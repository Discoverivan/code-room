{
  "name": "code-room",
  "version": "0.1.0",
  "description": "A minimal self-hosted real-time collaborative editor.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Discoverivan/code-room.git"
  },
  "bugs": {
    "url": "https://github.com/Discoverivan/code-room/issues"
  },
  "homepage": "https://github.com/Discoverivan/code-room#readme",
  "keywords": [
    "collaboration",
    "editor",
    "self-hosted",
    "yjs"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server-dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.11",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "lib0": "^0.2.114",
    "nanoid": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "ws": "^8.21.3",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
